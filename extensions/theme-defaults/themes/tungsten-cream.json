	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#776E60", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
			"settings": { "foreground": "#5C6B2E" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#A85423" }
		},
		{
			"scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"],
			"settings": { "foreground": "#8C4A6B" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#1B5F78" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#6B5B21" }
		},
		{
			"scope": ["variable", "variable.other.readwrite", "meta.definition.variable entity.name.function"],
			"settings": { "foreground": "#3B3733" }
		},
		{
			"scope": ["variable.parameter", "meta.parameters variable"],
			"settings": { "foreground": "#4A453F" }
		},
		{
			"scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"],
			"settings": { "foreground": "#2A6E6E" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#A3402B" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#8A6D1B" }
		},
		{
			"scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
			"settings": { "foreground": "#6B635A" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#A3402B" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#8F4227", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code.block"],
			"settings": { "foreground": "#5C6B2E" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#A94F2F" }
		}
	],
	"semanticHighlighting": true
}
